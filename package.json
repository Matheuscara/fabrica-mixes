{
  "name": "fabrica-mixes",
  "private": true,
  "type": "module",
  "description": "Gera mixes longos para YouTube juntando músicas + imagem/loop de cada canal.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "typecheck": "tsc",
    "smoke": "node --disable-warning=ExperimentalWarning test/smoke.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
