# Apenas localhost por padrão. Acesse outra máquina via túnel/VPN/reverse proxy protegido.
# Para LAN privada, defina o IP privado da interface e restrinja o acesso no firewall.
BIND_HOST=127.0.0.1
# Porta do site no servidor
PORT=8080
# Pasta no servidor com banco, músicas, visuais e vídeos gerados (~1-2 GB por hora de vídeo)
DATA_PATH=./data
TZ=America/Sao_Paulo
