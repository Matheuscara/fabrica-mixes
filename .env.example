# Localhost only by default. Reach it from another machine via a protected tunnel/VPN/reverse proxy.
# For a private LAN, set the interface's private IP and restrict access in the firewall.
BIND_HOST=127.0.0.1
# Site port on the server
PORT=8080
# Server folder holding the database, songs, visuals and rendered videos (~1-2 GB per hour of video)
DATA_PATH=./data
TZ=America/Sao_Paulo
